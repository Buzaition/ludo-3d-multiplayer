# Render provides PORT automatically.
PORT=3000

# Points validation analytics persistence.
# Recommended: use a SEPARATE GitHub repo for analytics data so analytics commits
# do not trigger Render auto-deploys of the game repository.
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=
GITHUB_REPO=ludo-analytics-data
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data/analytics.json

# Optional: instead of OWNER/REPO/PATH above, provide the full GitHub Contents API URL.
# Example: https://api.github.com/repos/OWNER/ludo-analytics-data/contents/data/analytics.json
GITHUB_ANALYTICS_API_URL=

# Writes are buffered and also flushed shortly after activity. PURCHASE_INTENT is persisted faster.
# The admin dashboard can trigger a manual flush for diagnostics.
ANALYTICS_FLUSH_MS=30000

# Optional protection for /admin.html analytics API.
ADMIN_KEY=
